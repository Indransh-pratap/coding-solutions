#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int n;
    cin >>n ;
    vector < int > arr(n);

    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    vector < int > nse(n, -1);

    stack < int > st;

    for (int i = 0; i < n; i++) {

        while (!st.empty() && arr[i] < arr[st.top()]) {
           nse[st.top()] = arr[i];
            st.pop();
        }

        st.push(i);

    }
    
    for(int i=0; i<n; i++){
        cout<<nse[i]<<" ";
    }
}