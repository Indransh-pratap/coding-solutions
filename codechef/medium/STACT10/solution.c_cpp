#include <iostream>

#include <vector>

#include <stack>

using namespace std;

int main() {
    int n;
    cin >> n;

    vector < int > arr(n);
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    stack < int > st;

    // Initialize the NGE array
    vector < int > nge(n, -1);

    // Iterating the array from right to left
    for (int i = 0; i < n; i++) {
        while (!st.empty() && arr[i] > arr[st.top()]) {
            nge[st.top()] = arr[i];
            st.pop();
        }

        st.push(i);
    }

    // Print the NGE array
    for (int i = 0; i < n; i++) {
        cout << nge[i] << " ";
    }
    cout << endl;
}